APP_NAME=GP247
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Trusted proxies (comma-separated IPs/CIDRs) so request()->ip() returns the
# real visitor IP and https:// URLs generate correctly behind a proxy hop.
# Safe defaults apply without touching this:
#   - Bare host (Nginx/Apache -> php-fpm directly): leave unset, nothing to
#     trust - trusting anything here would let clients spoof X-Forwarded-*.
#   - Docker (docker-compose*.yml): defaults to REMOTE_ADDR, i.e. only the
#     compose-internal nginx hop. No action needed.
# Only when THIS deployment also sits behind an external CDN/LB do you need
# to set it - uncomment/adapt one preset below (keep REMOTE_ADDR first when
# running in Docker; on a bare host behind the same edge, drop REMOTE_ADDR).
# Docker note: applied at container (re)create - re-run `docker compose up -d`
# after changing it. Full rationale: config/trustedproxy.php.
#
# Cloudflare (https://www.cloudflare.com/ips/ - re-check periodically):
# TRUSTED_PROXIES="REMOTE_ADDR,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32"
#
# Google Cloud HTTP(S) Load Balancer:
# TRUSTED_PROXIES="REMOTE_ADDR,130.211.0.0/22,35.191.0.0/16"
#
# AWS ALB/ELB (no fixed public ranges - trust your VPC subnet the LB nodes
# live in, e.g.):
# TRUSTED_PROXIES="REMOTE_ADDR,10.0.0.0/16"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST: "mysql-local" = use the dockerized MySQL container (see
# COMPOSE_PROFILES below). For a remote/managed database, replace with its
# real hostname/IP instead (e.g. db.example.com or 127.0.0.1).
DB_HOST=mysql-local
DB_PORT=3306
DB_DATABASE=scart-db
DB_USERNAME=scar-user
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
LOG_SLACK_WEBHOOK_URL=

#========DOCKER=========
# Variables below are consumed ONLY by docker-compose*.yml (host/build side),
# never by the Laravel app - they carry the SC_DOCKER_ prefix so they're easy
# to tell apart from the app's own config (APP_*, DB_*, MAIL_*...). The app's
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD stay UNPREFIXED because Laravel reads
# them directly. Compose falls back to the classic defaults when a SC_DOCKER_*
# var is unset, so leaving this whole section untouched behaves exactly as
# before.
#
# Nothing to configure here for dev - the app container always runs as root
# (hardcoded in docker-compose.yml), so bind-mount permissions just work on
# any host (WSL2, Linux, macOS) with zero setup.
#
# Deploying to PRODUCTION instead? Add these two lines to that server's
# .env (not needed here - docker-compose.prod.yml defaults to UID/GID 1000
# if you don't):
#   SC_DOCKER_WWWUSER=<id -u of the user Docker runs as on that server>
#   SC_DOCKER_WWWGROUP=<id -g of that user>
# See DOCKER.md section 4 for details.
SC_DOCKER_PHP_VERSION=8.3
SC_DOCKER_INSTALL_XDEBUG=false
SC_DOCKER_XDEBUG_MODE=develop,debug

# Instance slug — leave UNSET to keep the classic single-project names
# (project "scart"/"scart-prod", containers "scart-app"..., volume
# "scart-vendor"...). Set it ONLY when you run several independent S-Cart
# projects on the SAME host: give each project directory its own unique slug
# (e.g. shopa, shopb) and it scopes the compose project name, every container
# name, the image tag and the named volumes so the stacks never collide or
# share a MySQL data volume. Each instance also needs its own SC_DOCKER_APP_PORT/
# SC_DOCKER_VITE_PORT/DB_PORT below (or put them behind a reverse proxy that
# routes by domain). See DOCKER.md "Run several projects on one host".
# SC_DOCKER_INSTANCE=shopa

# Host port mappings. When running multiple instances on one host, give each
# instance distinct ports here (e.g. shopa: 8001/5174/3307, shopb:
# 8002/5175/3308) — or don't publish them at all and front the stacks with a
# reverse proxy.
SC_DOCKER_APP_PORT=8000
SC_DOCKER_VITE_PORT=5173

# Toggle the dockerized MySQL container (service "mysql-local") on/off.
# Same switch for dev and prod:
#   db-local -> starts mysql-local, DB_HOST above should be "mysql-local"
#   (empty)  -> no local MySQL, DB_HOST above must point to your remote DB
# NOTE: this one keeps its exact name (NO SC_DOCKER_ prefix). COMPOSE_PROFILES
# is a Docker Compose built-in that the `docker compose` CLI reads directly to
# pick service profiles; renaming it would stop `up -d` from starting
# mysql-local.
COMPOSE_PROFILES=db-local

# Only used when COMPOSE_PROFILES=db-local above (root password for the
# mysql-local container). Unused when pointing at a remote/managed DB.
SC_DOCKER_DB_ROOT_PASSWORD=change_me_root

#========GP247=========
GP247_ADMIN_API_PLUGIN=1 #Enable, disable page libary online
GP247_ADMIN_API_TEMPLATE=1 #Enable, disable page libary online
GP247_ADMIN_LOG=1 #Log access admin
GP247_ADMIN_FORGOT_PASSWORD=1 #Enable feature forgot password
GP247_PROTECTED_PLUGINS="" #Plugin1,Plugin2
GP247_PROTECTED_TEMPLATES="" #Template1,Template2
GP247_API_MODE=1 #Active, deactive api service - prevent provide api service, as your-domain/api/service...
GP247_DB_PREFIX=gp247_ #Cannot change after install gp247
GP247_ADMIN_PREFIX=gp247_admin #Prefix url admin, ex: domain.com/gp247_admin
GP247_ADMIN_LOG_EXCEPT="" #Except log admin acess, default: password,password_confirmation
GP247_SEO_LANG=0 #Enable, disable seo lang
GP247_API_LICENSE= #License key use connect to API

