APP_NAME=GP247
APP_ENV=local
APP_KEY=
# Dedicated key for encrypting stored secrets (SMTP password, OAuth secrets, licenses),
# kept separate from APP_KEY so regenerating APP_KEY does not destroy them. Generate
# with: php artisan key:generate --show   (paste the value here). Leave empty to fall
# back to APP_KEY (gp247:doctor will warn). Rotate with: php artisan gp247:encryption-key-rotate
GP247_ENCRYPTION_KEY=
# Old dedicated keys (comma-separated), kept only during/after a key rotation so old
# rows still decrypt; remove once gp247:encryption-key-rotate reports 0 remaining old rows.
GP247_ENCRYPTION_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Trusted proxies (comma-separated IPs/CIDRs) so request()->ip() returns the
# real visitor IP and https:// URLs generate correctly behind a proxy hop.
# Safe defaults apply without touching this:
#   - Bare host (Nginx/Apache -> php-fpm directly): leave unset, nothing to
#     trust - trusting anything here would let clients spoof X-Forwarded-*.
#   - Docker (docker-compose*.yml): defaults to REMOTE_ADDR, i.e. only the
#     compose-internal nginx hop. No action needed.
# Only when THIS deployment also sits behind an external CDN/LB do you need
# to set it - uncomment/adapt one preset below (keep REMOTE_ADDR first when
# running in Docker; on a bare host behind the same edge, drop REMOTE_ADDR).
# Docker note: applied at container (re)create - re-run `docker compose up -d`
# after changing it. Full rationale: config/trustedproxy.php.
#
# Cloudflare (https://www.cloudflare.com/ips/ - re-check periodically):
# TRUSTED_PROXIES="REMOTE_ADDR,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32"
#
# Google Cloud HTTP(S) Load Balancer:
# TRUSTED_PROXIES="REMOTE_ADDR,130.211.0.0/22,35.191.0.0/16"
#
# AWS ALB/ELB (no fixed public ranges - trust your VPC subnet the LB nodes
# live in, e.g.):
# TRUSTED_PROXIES="REMOTE_ADDR,10.0.0.0/16"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql-local          #"mysql-local" = the Docker MySQL container (needs COMPOSE_PROFILES=db-local). Remote DB: its hostname/IP
DB_PORT=3306                 #Port Laravel connects to. Keep 3306 with mysql-local, even with several stacks on one host (host-side port = SC_DOCKER_DB_PORT)
DB_DATABASE=scart-db
DB_USERNAME=scar-user
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
LOG_SLACK_WEBHOOK_URL=

#========DOCKER=========
# Read ONLY by `docker compose` (docker-compose.yml = DEV, docker-compose.prod.yml
# = PROD) - Laravel never reads SC_DOCKER_*. Not using Docker? Ignore this section.
# Unset SC_DOCKER_* vars fall back to the default noted after each one.
# After editing: [build] vars -> docker compose up -d --build, others -> docker compose up -d
# (on prod add -f docker-compose.prod.yml).
#
# Several S-Cart stacks on ONE host? Docker tells stacks apart by project name, not
# by directory: two directories with the same SC_DOCKER_INSTANCE (or both unset) are
# ONE stack to Docker - `up` in the 2nd one takes over the 1st one's containers and
# its MySQL data, without any warning. So give every stack its own directory, its own
# SC_DOCKER_INSTANCE and its own host ports (the *_PORT vars below).
# DB_HOST=mysql-local and DB_PORT=3306 stay the SAME in every stack (each stack has
# a private network). Details: DOCKER.md, Q "Can I run several independent S-Cart
# projects on one host?".

# SC_DOCKER_INSTANCE=shopa               #Unique slug per stack on this host (a-z, 0-9, -, _). Unset = "scart". Set it BEFORE the first `up`; to change it later run `docker compose down` first (the stack then starts on new, empty volumes)
SC_DOCKER_PHP_VERSION=8.3                #[build] PHP version of the image. Default: 8.3
SC_DOCKER_XDEBUG_MODE=develop,debug      #Dev only. "off" = disable Xdebug without rebuilding. Default: develop,debug
# SC_DOCKER_WWWUSER=1000                 #[build] Prod only: `id -u` of the owner of the project files on the server. Default: 1000
# SC_DOCKER_WWWGROUP=1000                #[build] Prod only: `id -g` of that user. Default: 1000

# Host ports (host side of host:container) - must be different for each stack on the same host
SC_DOCKER_APP_PORT=8000                  #Website (nginx). Default: 8000 dev / 80 prod
SC_DOCKER_VITE_PORT=5173                 #Dev only: Vite dev server. Default: 5173
SC_DOCKER_DB_PORT=3306                   #Dev only: mysql-local for DB tools (HeidiSQL, DBeaver...). NOT the port Laravel uses (that is DB_PORT). Default: 3306

COMPOSE_PROFILES=db-local                #db-local = run the MySQL container "mysql-local" (set DB_HOST=mysql-local). Leave empty to use a remote/shared MySQL. Docker built-in name - do not rename
SC_DOCKER_DB_ROOT_PASSWORD=change_me_root  #Root password of mysql-local, applied only on its FIRST start (empty data volume). Required in prod. Quote it if it contains # or spaces

#========GP247=========
GP247_ADMIN_API_PLUGIN=1 #Enable, disable page libary online
GP247_ADMIN_API_TEMPLATE=1 #Enable, disable page libary online
GP247_ADMIN_LOG=1 #Log access admin
GP247_ADMIN_FORGOT_PASSWORD=1 #Enable feature forgot password
GP247_PROTECTED_PLUGINS="" #Plugin1,Plugin2
GP247_PROTECTED_TEMPLATES="" #Template1,Template2
GP247_API_MODE=1 #Active, deactive api service - prevent provide api service, as your-domain/api/service...
GP247_DB_PREFIX=gp247_ #Cannot change after install gp247
GP247_ADMIN_PREFIX=gp247_admin #Prefix url admin, ex: domain.com/gp247_admin
GP247_ADMIN_LOG_EXCEPT="" #Except log admin acess, default: password,password_confirmation
GP247_SEO_LANG=0 #Enable, disable seo lang
GP247_API_LICENSE= #License key use connect to API

